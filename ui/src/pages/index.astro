---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Today</title>
  </head>
  <body class="min-h-screen bg-gradient-to-b from-stone-100 to-stone-200 text-stone-900 antialiased">
    <main class="mx-auto grid max-w-4xl items-start gap-5 px-5 py-8 md:grid-cols-[minmax(0,1fr)_15rem]">
      <!-- Side module: what to bring today (whole day, not just now) -->
      <aside class="order-first space-y-5 md:sticky md:top-8 md:col-start-2 md:row-start-1">
      <section id="weather" class="rounded-3xl bg-white/80 p-5 shadow-sm ring-1 ring-stone-200 backdrop-blur">
        <h2 class="label">Before you leave</h2>
        <p id="w-temp" class="text-sm text-stone-500">Checking the weather…</p>
        <ul id="w-items" class="mt-4 space-y-4"></ul>
        <div id="w-strip-wrap" class="mt-5 hidden">
          <div class="mb-1 flex justify-between text-[10px] uppercase tracking-wider text-stone-400"><span>Rain chance</span><span>9a–11p</span></div>
          <div id="w-strip" class="flex h-10 items-end gap-[2px]"></div>
        </div>
        <p class="mt-4 text-[10px] text-stone-400">Hyde Park · Open-Meteo</p>
      </section>

      <!-- Daily quote: same all day, new each day -->
      <section class="rounded-3xl bg-white/80 p-5 shadow-sm ring-1 ring-stone-200 backdrop-blur">
        <h2 class="label">Today’s quote</h2>
        <blockquote>
          <p id="q-text" class="font-serif text-lg leading-snug text-stone-800"></p>
          <footer id="q-by" class="mt-3 text-xs text-stone-500"></footer>
        </blockquote>
      </section>
      </aside>

      <div class="rounded-3xl bg-white/80 p-6 shadow-sm ring-1 ring-stone-200 backdrop-blur md:col-start-1 md:row-start-1">
        <!-- Header -->
        <header class="flex items-start justify-between gap-4">
          <div>
            <h1 id="title" class="cursor-pointer text-4xl font-bold tracking-tight">Today</h1>
            <p id="date" class="mt-1 text-stone-500">Loading…</p>
          </div>
          <nav class="flex gap-2 pt-2 text-sm">
            <button id="prev" class="rounded-full px-3 py-1 ring-1 ring-stone-300 hover:bg-stone-100 disabled:opacity-30"></button>
            <button id="next" class="rounded-full px-3 py-1 ring-1 ring-stone-300 hover:bg-stone-100 disabled:opacity-30"></button>
          </nav>
        </header>
        <p id="focus" class="mt-4 hidden rounded-lg bg-stone-900 px-3 py-2 text-sm font-medium text-white"></p>

        <!-- Yesterday -->
        <section id="recap-wrap" class="mt-6 hidden">
          <h2 class="label">Yesterday</h2>
          <p id="recap" class="text-sm text-stone-600"></p>
        </section>

        <!-- Schedule -->
        <section class="mt-6">
          <div class="mb-2 flex items-baseline justify-between">
            <h2 class="label !mb-0">Schedule</h2>
            <span id="status" class="text-xs text-stone-400"></span>
          </div>
          <div id="sky" class="relative overflow-hidden rounded-2xl p-2 ring-1 ring-stone-200 transition-[background] duration-1000">
            <div id="orb" class="pointer-events-none absolute rounded-full transition-all duration-1000"></div>
            <ol id="blocks" class="relative space-y-2"></ol>
            <!-- The line is thin; the wrapper gives a taller invisible hover zone. Time shows only on hover. -->
            <div id="nowbar" class="group absolute inset-x-0 z-10 hidden -translate-y-1/2 cursor-default py-2 transition-[top] duration-1000">
              <div class="relative h-0.5 bg-rose-500/40 shadow-[0_0_6px_rgba(244,63,94,.25)] transition-colors group-hover:bg-rose-500/80">
                <span class="absolute -left-0.5 -top-[5px] h-3 w-3 rounded-full bg-rose-500/60 ring-2 ring-white/60"></span>
                <span id="nowlabel" class="pointer-events-none absolute -top-7 left-3 rounded-full bg-rose-500 px-2 py-0.5 text-xs font-semibold text-white opacity-0 shadow transition-opacity duration-150 group-hover:opacity-100"></span>
              </div>
            </div>
          </div>
        </section>

        <!-- Rules bent -->
        <section id="exceptions-wrap" class="mt-4 hidden rounded-xl bg-amber-50 px-4 py-3 ring-1 ring-amber-200">
          <h2 class="label !text-amber-700">Rules bent (you approved)</h2>
          <ul id="exceptions" class="space-y-1 text-sm text-amber-900"></ul>
        </section>

        <!-- Tasks -->
        <section class="mt-6">
          <div class="mb-2 flex items-baseline justify-between">
            <h2 class="label !mb-0">Due</h2>
            <span class="text-xs text-stone-400">Tap a task to update progress</span>
          </div>
          <ul id="tasks" class="divide-y divide-stone-100 overflow-hidden rounded-2xl bg-white ring-1 ring-stone-200"></ul>
          <details id="past-wrap" class="mt-3 hidden text-sm text-stone-400">
            <summary class="cursor-pointer select-none">Already due (<span id="past-count"></span>)</summary>
            <ul id="past" class="mt-2 space-y-1 pl-4"></ul>
          </details>
        </section>

        <!-- Carried over -->
        <section id="carried-wrap" class="mt-6 hidden">
          <h2 class="label">Carried over</h2>
          <ul id="carried" class="space-y-2"></ul>
        </section>
      </div>
      <p class="text-center text-xs text-stone-400 md:col-start-1">Plans come from your morning check-in in Claude Code. Progress is yours; Claude only reads it.</p>
    </main>

    <script>
      import { quoteFor } from '../quotes';
      type Block = { start: string; end: string; title: string; kind: string; note?: string; task_id?: string; course?: string };
      type Task = { id: string; title: string; course: string; due: string; type: string; status: string };
      type Event = { title: string; course: string; date: string; start: string; end: string; type: string };
      type Subtask = { id: string; title: string; done: boolean };
      type Progress = { percent: number; subtasks: Subtask[] };
      type Data = {
        date: string; today: string; weekOf: string; saved: string | null; planDates: string[];
        plan: null | { summary?: string; recap?: string; blocks: Block[]; carried_over?: string[]; exceptions?: string[] };
        events: Event[]; tasks: Task[]; progress: Record<string, Progress>;
      };

      const COURSE: Record<string, string> = {
        DBS: 'bg-violet-100 text-violet-700', Systems: 'bg-rose-100 text-rose-700',
        'Gen AI': 'bg-amber-100 text-amber-800', Distributed: 'bg-teal-100 text-teal-700',
      };

      const $ = (id: string) => document.getElementById(id)!;
      const esc = (s = '') => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
      const day = (iso: string, opts: Intl.DateTimeFormatOptions) => new Date(iso + 'T12:00').toLocaleDateString('en-US', opts);
      const addDays = (iso: string, n: number) => {
        const d = new Date(iso + 'T12:00'); d.setDate(d.getDate() + n);
        return d.toISOString().slice(0, 10);
      };
      const daysBetween = (a: string, b: string) => Math.round((new Date(b + 'T12:00').getTime() - new Date(a + 'T12:00').getTime()) / 864e5);
      const toMin = (t: string) => { const [h, m] = t.split(':').map(Number); return h * 60 + m; };
      function time(t: string) {
        const [h, m] = t.split(':').map(Number);
        const hh = h % 24;
        return `${((hh + 11) % 12) + 1}:${String(m).padStart(2, '0')} ${hh < 12 ? 'AM' : 'PM'}`;
      }
      const pill = (course?: string) => course ? `<span class="rounded-full px-2 py-0.5 text-xs font-medium ${COURSE[course] ?? 'bg-stone-100 text-stone-600'}">${esc(course)}</span>` : '';

      // ---------- Sky: color and sun/moon position for a time of day ----------
      // Chicago, early November: sunrise ~6:25am, sunset ~4:40pm.
      const RISE = 6 * 60 + 25, SET = 16 * 60 + 40;
      const SKY: [number, string][] = [
        [0, '#0f172a'], [RISE - 40, '#1e293b'], [RISE, '#fdba74'], [RISE + 70, '#fde7c7'],
        [9 * 60, '#dbeafe'], [12 * 60 + 30, '#bae6fd'], [15 * 60, '#dbeafe'],
        [SET - 30, '#fed7aa'], [SET, '#fb923c'], [SET + 35, '#7c3aed'], [SET + 90, '#1e1b4b'],
        [24 * 60, '#0f172a'], [26 * 60, '#0f172a'],
      ];
      const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
      function skyColor(t: number) {
        for (let i = 1; i < SKY.length; i++) {
          if (t <= SKY[i][0]) {
            const [t0, c0] = SKY[i - 1], [t1, c1] = SKY[i];
            const f = (t - t0) / (t1 - t0), a = hex(c0), b = hex(c1);
            const rgb = a.map((v, k) => Math.round(v + (b[k] - v) * f));
            return { css: `rgb(${rgb.join(',')})`, dark: (0.299 * rgb[0] + 0.587 * rgb[1] + 0.114 * rgb[2]) / 255 < 0.5 };
          }
        }
        return { css: '#0f172a', dark: true };
      }
      // Current time of day in minutes. `?now=14:30` in the URL overrides it for testing.
      function nowMinutes() {
        const o = new URLSearchParams(location.search).get('now');
        if (o && /^\d{1,2}:\d{2}$/.test(o)) return toMin(o);
        const d = new Date();
        return d.getHours() * 60 + d.getMinutes();
      }

      // One big sun or moon for right now: rises on the left, peaks in the middle at noon, sets on the right.
      function paintSky(t: number) {
        const sky = $('sky'), orb = $('orb');
        const top = skyColor(t), bottom = skyColor(t + 75);
        sky.style.background = `linear-gradient(to bottom, ${top.css}, ${bottom.css})`;

        const day = t >= RISE - 15 && t <= SET + 15;
        const f = day
          ? (t - RISE) / (SET - RISE)
          : ((t < RISE ? t + 1440 : t) - SET) / (RISE + 1440 - SET);
        const ff = Math.min(1, Math.max(0, f));
        const size = 150;
        const W = sky.clientWidth, H = Math.max(sky.clientHeight, 260);
        const lift = Math.sin(Math.PI * ff); // 0 at the horizon, 1 at the top of the arc
        orb.style.width = orb.style.height = `${size}px`;
        orb.style.left = `${ff * W - size / 2}px`;
        orb.style.top = `${(1 - lift) * (H * 0.75) - size * 0.25}px`;

        if (day) {
          const low = lift < 0.35;
          orb.style.background = low
            ? 'radial-gradient(circle, #fb923c 0 38%, rgba(251,146,60,.35) 39% 55%, transparent 70%)'
            : 'radial-gradient(circle, #fde047 0 36%, rgba(253,224,71,.4) 37% 52%, transparent 70%)';
          orb.style.boxShadow = 'none';
        } else {
          // Crescent: a pale disc with a sky-colored disc offset over it.
          orb.style.background = `radial-gradient(circle at 64% 36%, ${top.css} 0 30%, transparent 31%), radial-gradient(circle, #f1f5f9 0 36%, rgba(241,245,249,.18) 37% 52%, transparent 70%)`;
        }
      }

      // Slide the "now" line down the schedule and tag the current or next block.
      function updateNow() {
        if (!current) return;
        const t = nowMinutes();
        paintSky(t);
        const bar = $('nowbar');
        const rows = [...$('blocks').querySelectorAll<HTMLElement>('[data-start]')];
        rows.forEach((r) => { r.classList.remove('ring-2', 'ring-rose-400'); r.querySelector('[data-tag]')!.innerHTML = ''; });
        if (current.date !== current.today || !rows.length) { bar.classList.add('hidden'); return; }

        const skyTop = $('sky').getBoundingClientRect().top;
        const box = (r: HTMLElement) => { const b = r.getBoundingClientRect(); return { top: b.top - skyTop, bottom: b.bottom - skyTop }; };
        let y = 0, tag: HTMLElement | null = null, label = '';
        const at = rows.findIndex((r) => t >= toMin(r.dataset.start!) && t < toMin(r.dataset.end!));
        if (at >= 0) {
          const r = rows[at], s = toMin(r.dataset.start!), e = toMin(r.dataset.end!), b = box(r);
          y = b.top + ((t - s) / (e - s)) * (b.bottom - b.top);
          tag = r; label = 'Now';
        } else {
          const next = rows.findIndex((r) => toMin(r.dataset.start!) > t);
          if (next === -1) y = box(rows[rows.length - 1]).bottom + 4;
          else {
            y = next === 0 ? box(rows[0]).top - 4 : (box(rows[next - 1]).bottom + box(rows[next]).top) / 2;
            const mins = toMin(rows[next].dataset.start!) - t;
            tag = rows[next]; label = `Up next · ${mins < 60 ? `${mins} min` : `${Math.floor(mins / 60)}h ${mins % 60}m`}`;
          }
        }
        bar.style.top = `${y}px`;
        bar.classList.remove('hidden');
        $('nowlabel').textContent = time(`${Math.floor(t / 60)}:${String(t % 60).padStart(2, '0')}`);
        if (tag) {
          tag.classList.add('ring-2', 'ring-rose-400');
          tag.querySelector('[data-tag]')!.innerHTML = `<span class="rounded-full bg-rose-500 px-2 py-0.5 text-xs font-semibold text-white">${label}</span>`;
        }
      }

      // ---------- Importance ----------
      const IMPORTANCE: Record<string, { label: string; level: number; cls: string; edge: string }> = {
        exam: { label: 'Exam', level: 3, cls: 'bg-rose-600 text-white', edge: 'border-l-rose-600' },
        quiz: { label: 'Quiz', level: 2, cls: 'bg-orange-500 text-white', edge: 'border-l-orange-500' },
      };
      function importanceBadge(type?: string) {
        const imp = type ? IMPORTANCE[type] : undefined;
        if (!imp) return '';
        const bars = [1, 2, 3].map((i) => `<span class="inline-block w-[3px] rounded-sm ${i <= imp.level ? 'bg-current' : 'bg-current opacity-30'}" style="height:${3 + i * 2}px"></span>`).join('');
        return `<span class="inline-flex items-end gap-1 rounded-full px-2 py-0.5 text-xs font-semibold ${imp.cls}"><span class="inline-flex items-end gap-[2px] pb-[2px]">${bars}</span>${imp.label}</span>`;
      }

      // ---------- Schedule rows ----------
      function row(b: Block, course: string | undefined, type: string | undefined) {
        const sub = 'text-stone-500';
        const exam = b.kind === 'exam';
        return `<li data-start="${b.start}" data-end="${b.end}" class="flex items-start gap-3 rounded-xl bg-white/80 px-4 py-3 text-stone-900 shadow-sm backdrop-blur-sm">
          <span class="w-[4.5rem] shrink-0 pt-0.5 text-sm tabular-nums ${sub}">${time(b.start)}</span>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-baseline gap-x-2">
              <span class="${exam ? 'font-bold' : 'font-medium'} ${b.kind === 'buffer' || b.kind === 'break' ? 'opacity-60' : ''}">${esc(b.title)}</span>
              <span class="text-xs ${sub}">until ${time(b.end)}</span>
            </div>
            ${b.note ? `<p class="mt-0.5 text-sm ${sub}">${esc(b.note)}</p>` : ''}
          </div>
          <div class="flex shrink-0 flex-col items-end gap-1 pt-0.5"><span data-tag></span>${importanceBadge(exam ? 'exam' : type)}${pill(course)}</div>
        </li>`;
      }

      // ---------- Tasks with progress + subtasks ----------
      const open = new Set<string>();
      let current: Data | null = null;

      function ring(pct: number) {
        const r = 8, c = 2 * Math.PI * r;
        const color = pct >= 100 ? '#059669' : '#44403c';
        return `<svg width="22" height="22" viewBox="0 0 22 22" class="shrink-0 -rotate-90">
          <circle cx="11" cy="11" r="${r}" fill="none" stroke="#e7e5e4" stroke-width="3"/>
          ${pct > 0 ? `<circle cx="11" cy="11" r="${r}" fill="none" stroke="${color}" stroke-width="3" stroke-linecap="round"
            stroke-dasharray="${(pct / 100) * c} ${c}"/>` : ''}</svg>`;
      }

      function taskItem(t: Task, d: Data, planned: Map<string, Block>) {
        const p = d.progress[t.id] ?? { percent: 0, subtasks: [] };
        const n = daysBetween(d.date, t.due.slice(0, 10));
        const due = time(t.due.slice(11, 16));
        const when = n === 0 ? `Today ${due}` : n === 1 ? `Tomorrow ${due}` : `${day(t.due.slice(0, 10), { weekday: 'short' })} ${due}`;
        const b = planned.get(t.id);
        const doneTask = p.percent >= 100;
        const cover = doneTask ? `<span class="text-xs text-emerald-700">Done</span>`
          : !d.plan ? '' : b ? `<span class="text-xs text-emerald-700">Planned ${time(b.start)}</span>`
          : n <= 1 ? `<span class="text-xs font-medium text-amber-700">Not scheduled today</span>` : '';
        const left = p.subtasks.filter((s) => !s.done).length;
        const isOpen = open.has(t.id);
        const imp = IMPORTANCE[t.type];

        return `<li data-task="${t.id}" class="border-l-4 ${imp ? imp.edge : 'border-l-transparent'}">
          <button data-act="toggle" class="flex w-full items-center gap-3 px-4 py-3 text-left hover:bg-stone-50">
            ${ring(p.percent)}
            <div class="min-w-0 flex-1">
              <div class="font-medium ${doneTask ? 'text-stone-400 line-through' : ''}">${esc(t.title)}</div>
              <div class="flex flex-wrap gap-x-3 text-xs text-stone-500">
                <span class="tabular-nums">${p.percent}%</span>
                ${p.subtasks.length ? `<span>${left ? `${left} step${left > 1 ? 's' : ''} left` : 'All steps done'}</span>` : ''}
                ${cover}
              </div>
            </div>
            <div class="flex shrink-0 flex-col items-end gap-1">
              <div class="flex gap-1">${importanceBadge(t.type)}${pill(t.course)}</div>
              <span class="text-sm ${n <= 1 && !doneTask ? 'font-medium text-rose-600' : 'text-stone-500'}">${when}</span>
            </div>
          </button>
          ${isOpen ? `<div class="space-y-3 bg-stone-50 px-4 pb-4 pt-2">
            <label class="flex items-center gap-3 text-sm">
              <span class="w-20 text-stone-500">Progress</span>
              <input data-act="percent" type="range" min="0" max="100" step="5" value="${p.percent}" class="flex-1 accent-stone-800"/>
              <output class="w-10 text-right tabular-nums font-medium">${p.percent}%</output>
            </label>
            <ul class="space-y-1">
              ${p.subtasks.map((s) => `<li class="flex items-center gap-2 text-sm">
                <input data-act="check" data-sub="${s.id}" type="checkbox" ${s.done ? 'checked' : ''} class="h-4 w-4 accent-stone-800"/>
                <span class="flex-1 ${s.done ? 'text-stone-400 line-through' : ''}">${esc(s.title)}</span>
                <button data-act="remove" data-sub="${s.id}" class="px-1 text-stone-400 hover:text-rose-600" aria-label="Remove">×</button>
              </li>`).join('')}
            </ul>
            <input data-act="add" type="text" placeholder="Add a step, e.g. Finish last 2 problems" class="w-full rounded-lg bg-white px-3 py-2 text-sm ring-1 ring-stone-200 focus:outline-none focus:ring-stone-400"/>
          </div>` : ''}
        </li>`;
      }

      function render(d: Data) {
        current = d;
        const isToday = d.date === d.today;
        const offset = daysBetween(d.today, d.date);
        $('title').textContent = isToday ? 'Today' : offset === -1 ? 'Yesterday' : offset === 1 ? 'Tomorrow' : day(d.date, { weekday: 'long' });
        $('date').textContent = day(d.date, { weekday: 'long', month: 'long', day: 'numeric' });

        const first = d.weekOf, last = addDays(d.weekOf, 6);
        const prev = addDays(d.date, -1), next = addDays(d.date, 1);
        ($('prev') as HTMLButtonElement).disabled = prev < first;
        ($('next') as HTMLButtonElement).disabled = next > last;
        $('prev').textContent = `‹ ${day(prev, { weekday: 'short' })}`;
        $('next').textContent = `${day(next, { weekday: 'short' })} ›`;

        const plan = d.plan;
        $('focus').classList.toggle('hidden', !plan?.summary);
        $('focus').textContent = plan?.summary ?? '';
        $('recap-wrap').classList.toggle('hidden', !plan?.recap);
        $('recap').textContent = plan?.recap ?? '';

        const taskById = Object.fromEntries(d.tasks.map((t) => [t.id, t]));
        const todaysEvents = d.events.filter((e) => e.date === d.date);
        if (plan) {
          $('status').textContent = `Planned ${new Date(d.saved!).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}`;
          $('blocks').innerHTML = plan.blocks.map((b) => {
            const t = b.task_id ? taskById[b.task_id] : undefined;
            return row(b, b.course ?? t?.course, t?.type);
          }).join('');
        } else {
          $('status').textContent = 'Not planned yet';
          $('blocks').innerHTML = todaysEvents.length
            ? todaysEvents.map((e) => row({ ...e, kind: e.type }, e.course, e.type)).join('')
            : `<li class="rounded-xl bg-white/80 px-4 py-6 text-center text-sm text-stone-400">No classes. ${isToday ? 'Say <span class="font-mono text-stone-600">good morning</span> in Claude Code to plan the day.' : ''}</li>`;
        }

        const ex = plan?.exceptions ?? [];
        $('exceptions-wrap').classList.toggle('hidden', !ex.length);
        $('exceptions').innerHTML = ex.map((s) => `<li>${esc(s)}</li>`).join('');

        const planned = new Map<string, Block>();
        for (const b of plan?.blocks ?? []) if (b.task_id && !planned.has(b.task_id)) planned.set(b.task_id, b);
        const sorted = [...d.tasks].sort((a, b) => a.due.localeCompare(b.due));
        const upcoming = sorted.filter((t) => t.due.slice(0, 10) >= d.date);
        const past = sorted.filter((t) => t.due.slice(0, 10) < d.date);

        $('tasks').innerHTML = upcoming.map((t) => taskItem(t, d, planned)).join('')
          || `<li class="px-4 py-6 text-center text-sm text-stone-400">Nothing else due this week.</li>`;

        $('past-wrap').classList.toggle('hidden', !past.length);
        $('past-count').textContent = String(past.length);
        $('past').innerHTML = past.map((t) => `<li>${esc(t.title)} · ${(d.progress[t.id]?.percent ?? 0)}%</li>`).join('');

        const carried = plan?.carried_over ?? [];
        $('carried-wrap').classList.toggle('hidden', !carried.length);
        $('carried').innerHTML = carried.map((s) => `<li class="rounded-xl border border-dashed border-stone-300 px-4 py-2 text-sm text-stone-600">${esc(s)}</li>`).join('');
        requestAnimationFrame(updateNow);
        loadWeather(d);
        const q = quoteFor(d.date);
        $('q-text').textContent = `“${q.text}”`;
        $('q-by').textContent = `— ${q.by}`;
      }

      // ---------- Saving progress (I make this change, not Claude) ----------
      async function save(taskId: string, patch: Partial<Progress>) {
        await fetch('/api/progress.json', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ task_id: taskId, ...patch }),
        });
        last = ''; // force a re-render with fresh data
        load();
      }
      const subtasksOf = (id: string) => structuredClone(current?.progress[id]?.subtasks ?? []);

      $('tasks').addEventListener('click', (ev) => {
        const el = (ev.target as HTMLElement).closest('[data-act]') as HTMLElement | null;
        const li = (ev.target as HTMLElement).closest('[data-task]') as HTMLElement | null;
        if (!el || !li) return;
        const id = li.dataset.task!;
        if (el.dataset.act === 'toggle') {
          open.has(id) ? open.delete(id) : open.add(id);
          if (current) render(current);
          if (open.has(id)) (li.parentElement?.querySelector(`[data-task="${id}"] [data-act="add"]`) as HTMLInputElement | null)?.focus();
        } else if (el.dataset.act === 'remove') {
          save(id, { subtasks: subtasksOf(id).filter((s) => s.id !== el.dataset.sub) });
        }
      });
      $('tasks').addEventListener('input', (ev) => {
        const el = ev.target as HTMLInputElement;
        if (el.dataset.act === 'percent') (el.nextElementSibling as HTMLOutputElement).value = `${el.value}%`;
      });
      $('tasks').addEventListener('change', (ev) => {
        const el = ev.target as HTMLInputElement;
        const id = (el.closest('[data-task]') as HTMLElement).dataset.task!;
        if (el.dataset.act === 'percent') save(id, { percent: Number(el.value) });
        if (el.dataset.act === 'check') save(id, { subtasks: subtasksOf(id).map((s) => s.id === el.dataset.sub ? { ...s, done: el.checked } : s) });
      });
      $('tasks').addEventListener('keydown', (ev) => {
        const el = ev.target as HTMLInputElement;
        if (el.dataset.act !== 'add' || ev.key !== 'Enter' || !el.value.trim()) return;
        const id = (el.closest('[data-task]') as HTMLElement).dataset.task!;
        save(id, { subtasks: [...subtasksOf(id), { id: Date.now().toString(36), title: el.value.trim(), done: false }] })
          .then(() => (document.querySelector(`[data-task="${id}"] [data-act="add"]`) as HTMLInputElement | null)?.focus());
      });

      // ---------- Weather: what to bring for the whole day ----------
      type Weather = {
        date: string; desc: string; hi: number; lo: number; error?: string;
        rain: { likely: boolean; chance: number; window: { from: string; to: string } | null };
        sun: { likely: boolean; window: { from: string; to: string } | null };
        hourly: { hour: number; rain: number; cloud: number }[];
      };
      let weatherFor = '';
      const span = (w: { from: string; to: string }) => `${time(w.from).replace(':00', '')}–${time(w.to).replace(':00', '')}`;

      // Tie the rain to my classes: am I walking to or from class while it rains?
      function rainContext(win: { from: string; to: string }, d: Data) {
        const [a, b] = [toMin(win.from), toMin(win.to)];
        for (const e of d.events.filter((x) => x.date === d.date)) {
          const leave = toMin(e.start) - 20, home = toMin(e.end);
          if (leave >= a - 30 && leave <= b) return `on your way to ${e.course}`;
          if (home >= a - 30 && home <= b) return `on your way home from ${e.course}`;
        }
        return '';
      }

      function item(icon: string, title: string, detail: string) {
        return `<li class="flex items-start gap-3">
          <span class="text-3xl leading-none">${icon}</span>
          <div><div class="font-semibold">${title}</div><div class="text-xs text-stone-500">${detail}</div></div>
        </li>`;
      }

      async function loadWeather(d: Data) {
        if (weatherFor === d.date) return;
        weatherFor = d.date;
        $('w-temp').textContent = 'Checking the weather…';
        $('w-items').innerHTML = '';
        $('w-strip-wrap').classList.add('hidden');
        let w: Weather;
        try { w = await (await fetch(`/api/weather.json?date=${d.date}`)).json(); } catch { w = { error: 'offline' } as Weather; }
        if (weatherFor !== d.date) return; // navigated away meanwhile
        if (w.error) { $('w-temp').textContent = 'Weather unavailable right now.'; return; }

        $('w-temp').textContent = `${w.desc} · ${w.hi}° / ${w.lo}°`;
        const items: string[] = [];
        if (w.rain.likely && w.rain.window) {
          const ctx = rainContext(w.rain.window, d);
          items.push(item('☂️', 'Bring an umbrella', `${w.rain.chance}% chance · ${span(w.rain.window)}${ctx ? ` · ${ctx}` : ''}`));
        }
        if (w.sun.likely && w.sun.window) items.push(item('🕶️', 'Sunglasses', `Sunny ${span(w.sun.window)}`));
        if (!items.length) items.push(item('👍', 'Nothing extra', w.rain.chance ? `Low rain chance (${w.rain.chance}%), no sun` : 'Dry and overcast'));
        $('w-items').innerHTML = items.join('');

        $('w-strip-wrap').classList.remove('hidden');
        $('w-strip').innerHTML = w.hourly.map((h) =>
          `<span title="${time(`${h.hour}:00`)}: ${h.rain}% rain, ${h.cloud}% clouds" class="flex-1 rounded-sm ${h.rain >= 40 ? 'bg-sky-500' : 'bg-sky-200'}" style="height:${Math.max(6, h.rain)}%"></span>`
        ).join('');
      }

      // ---------- Polling ----------
      // Follow the harness's "today" until I navigate; then stay on the chosen day.
      let viewing: string | null = null;
      let last = '';
      async function load() {
        // Don't redraw under my cursor while I'm typing or dragging.
        const a = document.activeElement as HTMLInputElement | null;
        if (a && $('tasks').contains(a) && a.tagName === 'INPUT' && (a.type === 'text' ? a.value : false)) return;
        try {
          const res = await fetch(`/api/plan.json${viewing ? `?date=${viewing}` : ''}`, { cache: 'no-store' });
          const text = await res.text();
          if (text !== last) { last = text; render(JSON.parse(text)); }
        } catch {}
      }
      function go(n: number) {
        if (!current) return;
        viewing = addDays(current.date, n);
        if (viewing === current.today) viewing = null;
        load();
      }
      $('prev').addEventListener('click', () => go(-1));
      $('next').addEventListener('click', () => go(1));
      $('title').addEventListener('click', () => { viewing = null; load(); });
      load();
      setInterval(load, 2000);
      setInterval(updateNow, 30000);
      addEventListener('resize', updateNow);
    </script>
  </body>
</html>
