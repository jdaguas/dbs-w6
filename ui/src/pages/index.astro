---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Today</title>
  </head>
  <body class="bg-stone-50 text-stone-900 antialiased">
    <main class="mx-auto max-w-xl px-6 py-10">
      <header class="mb-6">
        <h1 class="text-3xl font-bold tracking-tight">Today</h1>
        <p id="date" class="text-sm text-stone-500">Waiting for your check-in…</p>
        <p id="summary" class="mt-3 text-stone-700"></p>
      </header>

      <section id="empty" class="rounded-xl border border-dashed border-stone-300 p-6 text-center text-stone-500">
        No plan yet. Say <span class="font-mono text-stone-700">good morning</span> in Claude Code.
      </section>

      <div id="content" class="hidden space-y-6">
        <section id="recap-wrap" class="hidden rounded-xl bg-white p-4 shadow-sm ring-1 ring-stone-200">
          <h2 class="mb-1 text-xs font-semibold uppercase tracking-wide text-stone-400">Yesterday</h2>
          <p id="recap" class="text-sm text-stone-700"></p>
        </section>

        <section>
          <h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-stone-400">Schedule</h2>
          <ol id="blocks" class="space-y-2"></ol>
        </section>

        <section id="deadlines-wrap" class="hidden">
          <h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-stone-400">Coming up</h2>
          <ul id="deadlines" class="space-y-1 text-sm"></ul>
        </section>

        <section id="carried-wrap" class="hidden">
          <h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-stone-400">Carried over</h2>
          <ul id="carried" class="space-y-1"></ul>
        </section>

        <section id="exceptions-wrap" class="hidden">
          <h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-stone-400">Rules bent today (approved)</h2>
          <ul id="exceptions" class="space-y-1 text-sm text-amber-800"></ul>
        </section>
      </div>

      <footer id="updated" class="mt-10 text-xs text-stone-400"></footer>
    </main>

    <script>
      type Block = { start: string; end: string; title: string; kind: string; weight?: string };
      type Plan = {
        date: string; day?: string; summary?: string; recap?: string;
        blocks: Block[];
        deadlines?: { title: string; due: string }[];
        carried_over?: string[]; exceptions?: string[];
      };

      const STYLE: Record<string, string> = {
        class: 'bg-indigo-50 ring-indigo-200 text-indigo-900',
        exam: 'bg-rose-100 ring-rose-300 text-rose-900 font-semibold',
        work: 'bg-white ring-stone-200',
        meal: 'bg-emerald-50 ring-emerald-200 text-emerald-900',
        gym: 'bg-sky-50 ring-sky-200 text-sky-900',
        break: 'bg-stone-100 ring-stone-200 text-stone-600',
        buffer: 'bg-stone-100 ring-stone-200 text-stone-500 italic',
      };

      const $ = (id: string) => document.getElementById(id)!;
      const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

      function to12(t: string) {
        const [h, m] = t.split(':').map(Number);
        const hr = ((h + 11) % 12) + 1;
        return `${hr}:${String(m).padStart(2, '0')}${h < 12 || h === 24 ? 'a' : 'p'}`;
      }

      function list(wrap: string, el: string, items: string[] | undefined, render: (s: string) => string) {
        $(wrap).classList.toggle('hidden', !items?.length);
        $(el).innerHTML = (items ?? []).map(render).join('');
      }

      function render(plan: Plan, updated: string) {
        $('empty').classList.add('hidden');
        $('content').classList.remove('hidden');

        const d = new Date(plan.date + 'T12:00');
        $('date').textContent = d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
        $('summary').textContent = plan.summary ?? '';

        $('recap-wrap').classList.toggle('hidden', !plan.recap);
        $('recap').textContent = plan.recap ?? '';

        $('blocks').innerHTML = plan.blocks.map((b) => `
          <li class="flex gap-4 rounded-lg px-4 py-3 shadow-sm ring-1 ${STYLE[b.kind] ?? STYLE.work}">
            <span class="w-28 shrink-0 font-mono text-sm tabular-nums opacity-70">${to12(b.start)}–${to12(b.end)}</span>
            <span class="flex-1">${esc(b.title)}</span>
            ${b.weight ? `<span class="text-xs uppercase tracking-wide opacity-50">${esc(b.weight)}</span>` : ''}
          </li>`).join('');

        const today = new Date(plan.date + 'T00:00');
        const deadlines = (plan.deadlines ?? []).map((x) => {
          const days = Math.round((new Date(x.due.slice(0, 10) + 'T00:00').getTime() - today.getTime()) / 864e5);
          const when = days <= 0 ? 'today' : days === 1 ? 'tomorrow' : `in ${days} days`;
          return `<li class="flex justify-between"><span>${esc(x.title)}</span><span class="${days <= 1 ? 'font-semibold text-rose-700' : 'text-stone-500'}">${when}</span></li>`;
        });
        $('deadlines-wrap').classList.toggle('hidden', !deadlines.length);
        $('deadlines').innerHTML = deadlines.join('');

        list('carried-wrap', 'carried', plan.carried_over, (s) =>
          `<li class="rounded-lg border border-stone-300 px-4 py-2 text-sm text-stone-600">${esc(s)}</li>`);
        list('exceptions-wrap', 'exceptions', plan.exceptions, (s) => `<li>• ${esc(s)}</li>`);

        $('updated').textContent = `Plan saved ${new Date(updated).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}`;
      }

      let last = '';
      async function poll() {
        try {
          const res = await fetch('/api/plan.json', { cache: 'no-store' });
          const { plan, updated } = await res.json();
          if (plan && updated !== last) {
            last = updated;
            render(plan, updated);
          }
        } catch {}
      }
      poll();
      setInterval(poll, 2000);
    </script>
  </body>
</html>
